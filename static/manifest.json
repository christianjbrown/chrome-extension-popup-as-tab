{
  "manifest_version": 3,
  "name": "Christian's Popup As Tab",
  "version": "1.0.0",
  "description": "Popup windows open as ordinary tabs instead, right next to the tab that opened them.",
  "minimum_chrome_version": "126",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
