#!/bin/sh
# What has to pass before a push leaves this repository.
#
# Opt in with `git config core.hooksPath .githooks` and git runs this before
# every push. It is committed rather than installed by hand, so a fresh clone
# has it ready.
#
# `npm run ci` and nothing else: formatting, lint, types, unused code, the whole
# suite at 100% coverage, and the build. The same entry point CI uses.
exec npm run ci
